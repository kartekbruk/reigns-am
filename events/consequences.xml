<?xml version="1.0" encoding="UTF-8"?>
<!--
  Consequence events — triggered by specific choices in events.xml.
  Same schema as events.xml. Wire via consequence="<id>" on a <left> or <right> element.
  Consequence events are NOT filtered by positions — they fire regardless of career level.
-->
<events>

