<?xml version="1.0" encoding="UTF-8"?>
<!--
  Consequence events — triggered by specific choices in events.xml.
  Same schema as events.xml. Wire via consequence="<id>" on a <left> or <right> element.
  Consequence events are NOT filtered by positions — they fire regardless of career level.
-->
<events>

  <event id="phishing_training" char_name="Kryz" char_role="Manager">
	<title>Phishing training</title>
	<text>Kliknąłeś w linka z phishingiem. Czas na szkolenie</text>
	<background>res://sprites/manager.png</background>
	<left text="Grzecznie robię szkolenie">
	  <effect attribute="wellbeing" value="-10"/>
	  <effect attribute="morale" value="0"/>
	  <effect attribute="codebase" value="0"/>
	  <effect attribute="prosperity" value="0"/>
	</left>
	<right text="Udaję, że nie widzę" consequence="phishing_training">
	  <effect attribute="wellbeing" value="0"/>
	  <effect attribute="morale" value="-5"/>
	  <effect attribute="codebase" value="0"/>
	  <effect attribute="prosperity" value="-1"/>
	</right>
  </event>

  <event id="commander_consequence" char_name="Kryz" char_role="Manager">
	<title>Konsekwencje Commandera</title>
	<text>Dokańczamy zaległego Commanderka?</text>
	<background>res://sprites/manager.png</background>
	<left text="Dość">
	  <effect attribute="wellbeing" value="0"/>
	  <effect attribute="morale" value="-15"/>
	  <effect attribute="codebase" value="0"/>
	  <effect attribute="prosperity" value="0"/>
	</left>
	<right text="Niech będzie..." consequence="rockets">
	  <effect attribute="wellbeing" value="-10"/>
	  <effect attribute="morale" value="10"/>
	  <effect attribute="codebase" value="0"/>
	  <effect attribute="prosperity" value="0"/>
	</right>
  </event>

  <event id="rockets" char_name="Kryz" char_role="Manager">
	<title>Rakiety</title>
	<text>Dobra przyniosłem granie w rakiety kosmiczne. Wystarczy, że weźmiecie sobie kalkulatory i posłuchacie jak przez 3 godziny tłumaczę zasady</text>
	<background>res://sprites/manager.png</background>
	<left text="Dooooość">
	  <effect attribute="wellbeing" value="-5"/>
	  <effect attribute="morale" value="-20"/>
	  <effect attribute="codebase" value="0"/>
	  <effect attribute="prosperity" value="0"/>
	</left>
	<right text="Zgadzam się ze łzami w oczach">
	  <effect attribute="wellbeing" value="-15"/>
	  <effect attribute="morale" value="15"/>
	  <effect attribute="codebase" value="0"/>
	  <effect attribute="prosperity" value="0"/>
	</right>
  </event>

  <event id="friday_deploy_consequence" char_name="Kryz" char_role="Manager">
	<title>Konsekwencje piątkowego deploya</title>
	<text>[23:30] Pamiętasz tego piątkowego deploya? Trzeba zrobić hotfixa</text>
	<background>res://sprites/manager.png</background>
	<left text="Udaję, że śpię">
	  <effect attribute="wellbeing" value="0"/>
	  <effect attribute="morale" value="-10"/>
	  <effect attribute="codebase" value="0"/>
	  <effect attribute="prosperity" value="-5"/>
	</left>
	<right text="Odpalam kompa">
	  <effect attribute="wellbeing" value="-15"/>
	  <effect attribute="morale" value="5"/>
	  <effect attribute="codebase" value="5"/>
	  <effect attribute="prosperity" value="1"/>
	</right>
  </event>

  <event id="palindrome_guy_consequence" char_name="Kryz" char_role="Manager">
	<title>Gość co nie umiał palindroma dropnął tabelę</title>
	<text>Gość co nie umiał palindroma dropnął tabelę na prodzie</text>
	<background>res://sprites/manager.png</background>
	<left text="Pomagam naprawić">
	  <effect attribute="wellbeing" value="-15"/>
	  <effect attribute="morale" value="5"/>
	  <effect attribute="codebase" value="5"/>
	  <effect attribute="prosperity" value="0"/>
	</left>
	<right text="Zwalam winę">
	  <effect attribute="wellbeing" value="0"/>
	  <effect attribute="morale" value="-15"/>
	  <effect attribute="codebase" value="0"/>
	  <effect attribute="prosperity" value="-5"/>
	</right>
  </event>

</events>
