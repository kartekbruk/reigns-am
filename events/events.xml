  <event id="enterprise_hack">
    <title>Customer Shortcut</title>
    <text>Your biggest client asks for a "temporary" hardcoded config flag to bypass the validation pipeline. They need it by Friday or they walk.</text>
    <background></background>
    <left text="Add the flag. Keep the client.">
      <effect attribute="wellbeing" value="-5"/>
      <effect attribute="morale" value="-8"/>
      <effect attribute="prosperity" value="20"/>
      <effect attribute="codebase" value="-18"/>
    </left>
    <right text="Offer a proper solution in three weeks.">
      <effect attribute="wellbeing" value="5"/>
      <effect attribute="morale" value="8"/>
      <effect attribute="prosperity" value="-18"/>
      <effect attribute="codebase" value="10"/>
    </right>
