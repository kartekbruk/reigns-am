      <effect attribute="morale" value="12"/>
      <effect attribute="prosperity" value="-10"/>
      <effect attribute="codebase" value="5"/>
    </right>
  </event>

  <event id="standup_length">
    <title>Meeting Culture</title>
	<text>Standups have crept to 45 minutes. One engineer says they're the only alignment we have. Another says they destroy deep work time.</text>
	<background></background>
	<left text="Keep long standups. Communication matters.">
	  <effect attribute="wellbeing" value="-8"/>
	  <effect attribute="morale" value="8"/>
	  <effect attribute="prosperity" value="5"/>
	  <effect attribute="codebase" value="-5"/>
	</left>
	<right text="15-minute cap, async updates for the rest.">
	  <effect attribute="wellbeing" value="12"/>
	  <effect attribute="morale" value="-5"/>
	  <effect attribute="prosperity" value="3"/>
	  <effect attribute="codebase" value="8"/>
	</right>
  </event>

