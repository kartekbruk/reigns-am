  <event id="oncall_rotation">
	<title>On-Call Roulette</title>
	<text>Three engineers are bearing the entire on-call load. They want a fair rotation. The rest of the team is nervous — they don't know the system well enough.</text>
    <background></background>
    <left text="Fair rotation for everyone.">
      <effect attribute="wellbeing" value="10"/>
      <effect attribute="morale" value="12"/>
      <effect attribute="prosperity" value="-5"/>
      <effect attribute="codebase" value="8"/>
    </left>
    <right text="Keep the specialists on-call.">
