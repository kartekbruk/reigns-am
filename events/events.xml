<?xml version="1.0" encoding="UTF-8"?>
<!--
  Event schema:
	id          – unique identifier (slug)
	title       – short card heading
	text        – event description shown on the card
	background  – res:// path to a background image (optional)
	char_name   – character name shown at the bottom
	char_role   – character position/role shown at the bottom
	positions   – space-separated list: intern junior mid senior
				  omit attribute (or leave empty) to show for all levels
	left/@text  – label for the left-swipe choice
	right/@text – label for the right-swipe choice
	effect/@attribute – one of: wellbeing | morale | prosperity | codebase
	effect/@value     – integer delta (positive or negative)
-->
