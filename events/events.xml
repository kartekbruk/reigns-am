  <event id="mandatory_code_review">
	<title>Review Policy</title>
	<text>After a costly regression, your TL proposes mandatory two-person code reviews on all PRs. Junior devs love it. Senior devs call it a bottleneck.</text>
	<background></background>
	<left text="Enforce two-person reviews.">
	  <effect attribute="wellbeing" value="-5"/>
	  <effect attribute="morale" value="5"/>
	  <effect attribute="prosperity" value="-5"/>
	  <effect attribute="codebase" value="18"/>
	</left>
